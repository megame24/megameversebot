{
  "name": "twitch-bible-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Posts a Bible verse to Twitch chat on a configurable interval.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "preview": "node --experimental-strip-types src/preview.ts",
    "authorize": "node --env-file=.env --experimental-strip-types src/authorize.ts",
    "whoami": "node --env-file=.env --experimental-strip-types src/whoami.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
