# Copy to .env and fill in. Never commit .env — it holds live credentials.
# Phase 2 (verse preview) needs none of this; it is required from Phase 1 onward.

# --- Twitch app credentials (dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Your channel's login name, lowercase (twitch.tv/<this>)
TWITCH_CHANNEL=

# Resolved once via GET /helix/users, then pasted here so we don't look them up every tick
BOT_USER_ID=
CHANNEL_USER_ID=

# --- Timing ---
INTERVAL_MINUTES=30
JITTER_MINUTES=2
# Every stream opens with a verse this long after going live, whatever the interval
OPENING_VERSE_MINUTES=5
POST_ON_START=false
ONLY_WHEN_LIVE=true

# --- Verses ---
TRANSLATION=WEB

# Hard ceiling per chat message. Twitch's limit is 500; the gap is safety margin.
MAX_MESSAGE_CHARS=480

# How many recently-used verses to exclude from selection
RECENT_MEMORY=500

# Note: there is deliberately no option to filter out genealogies or census lists.
# See "Odd verses are the point" in README.md.
